# ---------------------------------------------------------------------------
# Resend alerts for the live demo (/demo)
# ---------------------------------------------------------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where the developer alert is delivered. Only this fixed address is used;
# the demo never lets a visitor choose a recipient.
ALERT_TO_EMAIL=

# A verified sender in Resend. For initial testing, onboarding@resend.dev
# can only deliver to the email address that owns the Resend account.
ALERT_FROM_EMAIL="Proving Ground <onboarding@resend.dev>"

# Suppress duplicate DOWN emails for the same open incident.
# Set to 0 to email on every failed run (useful while demoing to several buyers).
DEMO_ALERT_COOLDOWN_SECONDS=180

# Optional: absolute base URL used in the email's "Open the incident" link.
# Inferred from the request when unset.
# APP_URL=https://proving-ground.example.com

# Optional: point the sender at a local mock server while testing.
# RESEND_API_URL=https://api.resend.com/emails
